{
  "name": "@gestcon/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --passWithNoTests",
    "test:integration": "npm run build && node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "npm run build && node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --coverage --runInBand"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15"
  }
}
