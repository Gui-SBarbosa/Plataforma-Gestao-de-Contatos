@startuml
skinparam componentStyle rectangle
left to right direction
actor Usuario
component "React + Vite" as Web
node "GestCon — Express" {
  component "REST API" as API
  component "Socket.IO" as Socket
  package "Módulos de domínio" {
    component "Auth" as Auth
    component "Registration" as Registration
    component "Admin Users" as AdminUsers
    component "Contacts" as Contacts
    component "Notifications" as Notifications
    component "Dashboard" as Dashboard
    component "Audit" as Audit
    component "Rate Limit" as RateLimit
  }
  component "Prisma repositories" as Repos
}
database PostgreSQL

Usuario --> Web
Web --> API : HTTPS/JSON
Web <--> Socket : WSS
API --> Auth
API --> Registration
API --> AdminUsers
API --> Contacts
API --> Notifications
API --> Dashboard
API --> Audit
API --> RateLimit
Auth --> Repos
Registration --> Repos
AdminUsers --> Repos
Contacts --> Repos
Notifications --> Repos
Dashboard --> Repos
Audit --> Repos
RateLimit --> Repos
Registration --> Notifications : persiste aviso
Contacts --> Notifications : persiste aviso
API --> Socket : eventos pós-commit
Repos --> PostgreSQL
@enduml
